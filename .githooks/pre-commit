#!/bin/sh
# dev-guard pre-commit: scans the WHOLE project (not just changed files) before every commit.
# Blocks the commit when malware signs are found. Install: sh dev-guard/hooks/install-hooks.sh
ROOT=$(git rev-parse --show-toplevel) || exit 1
G="$ROOT/scripts/dev-guard.mjs"
command -v node >/dev/null 2>&1 || { echo "dev-guard: Node.js is required. Commit BLOCKED."; exit 1; }
[ -f "$G" ] || { echo "dev-guard: scripts/dev-guard.mjs is missing. Commit BLOCKED."; exit 1; }
echo "dev-guard: scanning the full project before commit..."
node "$G" "$ROOT" || { echo "Commit BLOCKED by dev-guard. Fix the findings above first."; exit 1; }
if [ -f "$ROOT/scripts/malware-guard.mjs" ]; then node "$ROOT/scripts/malware-guard.mjs" || { echo "Commit BLOCKED by malware-guard."; exit 1; }; fi
SENS='(^|/)((postcss|tailwind|next|vite|vitest|jest|eslint|babel|webpack|rollup|nuxt|svelte|astro|metro|prettier|stylelint|playwright)\.config\.[cm]?[jt]s|\.eslintrc[^/]*|\.babelrc[^/]*|package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|\.npmrc|\.githooks/.*|\.github/.*|scripts/.*)$'
CH=$(git diff --cached --name-only | grep -E "$SENS" || true)
if [ -n "$CH" ]; then echo "dev-guard NOTICE: this commit changes sensitive files. Read each diff and be sure YOU made every change:"; echo "$CH" | sed 's/^/   /'; fi
exit 0
