# Copy this file to .env.local for local work (it is git-ignored), and set the same
# names in Vercel under Project, Settings, Environment Variables.
# Every value below is a DUMMY. Replace them with your own from the services named.
#
# All NEXT_PUBLIC_* variables are PUBLIC: they are compiled into the JavaScript that every
# visitor downloads. Never put a real secret in a NEXT_PUBLIC_* variable.
# This site has no private secrets and no server code that needs any.
#
# After changing any variable, redeploy: NEXT_PUBLIC_* values are read at build time.

# --- EmailJS (the contact form). Find these at https://dashboard.emailjs.com ---

# Account, General, Public Key. Safe to expose: it is meant for browsers.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=dummy_public_key_AbC123xYz

# Email Services, your connected service, its Service ID
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_dummy123

# Email Templates: the template that notifies YOU of a new enquiry
NEXT_PUBLIC_EMAILJS_ADMIN_TEMPLATE_ID=template_admin_dummy

# Email Templates: the template that auto-replies to the visitor
NEXT_PUBLIC_EMAILJS_USER_TEMPLATE_ID=template_user_dummy

# The address that receives enquiries. NOTE: this ends up visible in the site's JavaScript.
# Better: set a fixed "To email" inside the EmailJS admin template, then delete this variable
# and the line that uses it in app/services/emailService.ts.
NEXT_PUBLIC_EMAILJS_TO_EMAIL=you@example.com

# --- Optional: Google Search Console ---

# Search Console, Settings, Ownership verification, HTML tag: copy only the content="..." value.
# Not a secret (it appears in the page HTML), and not NEXT_PUBLIC_ because only the server reads it.
GOOGLE_SITE_VERIFICATION=dummy_verification_token_abc123
