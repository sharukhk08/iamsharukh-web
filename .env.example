# Copy this file to .env.local for local work (it is git-ignored), and set the same
# names in Vercel under Project, Settings, Environment Variables.
# Every value below is a DUMMY. Replace them with your own from the services named.
#
# The contact form posts to this site's own /api/enquiry route, which sends the email
# from the server. These variables have NO NEXT_PUBLIC_ prefix, so they are never sent
# to visitors. Never add NEXT_PUBLIC_ to them.
#
# After changing any variable, redeploy.

# --- EmailJS (the contact form). Find these at https://dashboard.emailjs.com ---

# Email Services, your connected service, its Service ID
EMAILJS_SERVICE_ID=service_dummy123

# Account, General, Public Key
EMAILJS_PUBLIC_KEY=dummy_public_key_AbC123xYz

# Account, General, Private Key (SECRET). Also turn on, under Account, Security, the option
# that allows API calls from non-browser applications, or EmailJS will reject the server.
EMAILJS_PRIVATE_KEY=dummy_private_key_do_not_share

# Email Templates: the template that notifies YOU of a new enquiry.
# Type your own address into its "To Email" field inside EmailJS (see docs/emailjs/README.md).
EMAILJS_ADMIN_TEMPLATE_ID=template_admin_dummy

# Email Templates: the auto-reply to the visitor ("To Email" = {{to_email}})
EMAILJS_USER_TEMPLATE_ID=template_user_dummy

# --- Optional ---

# Extra host names allowed to call /api/enquiry, comma separated (for example a Vercel
# preview URL host). iamsharukh.com and www.iamsharukh.com are always allowed.
ALLOWED_HOSTS=

# Search Console, Settings, Ownership verification, HTML tag: copy only the content="..." value.
GOOGLE_SITE_VERIFICATION=dummy_verification_token_abc123
